# ===========================================================
#  RAG System — Environment Variables (Production)
#  Copy this to backend/.env and fill in your keys
# ===========================================================

# --- LLM Provider (pick one) ---
# Option 1: OpenAI (paid)
OPENAI_API_KEY=

# Option 2: Google Gemini (free — https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Option 3: Ollama (free, local — requires separate Ollama container)
# OLLAMA_BASE_URL=http://ollama:11434/v1
# OLLAMA_MODEL=qwen2.5:3b

# --- Production Settings ---
RAG_ENV=prod
LOG_DEBUG_SAMPLE_RATE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=4

# --- Optional: CORS (comma-separated origins) ---
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
